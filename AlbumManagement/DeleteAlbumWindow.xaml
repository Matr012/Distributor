<Window x:Class="MMZClient.AlbumManagement.DeleteAlbumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Album" Height="240" Width="520" Background="Black"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Delete Album" FontSize="18" Foreground="Turquoise"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <Label Grid.Row="1" Content="Album ID:" Foreground="Turquoise" VerticalAlignment="Center"/>
        <TextBox x:Name="tbxAlbumId" Grid.Row="1" Margin="100,0,0,16" Width="220" HorizontalAlignment="Left"
                 Background="Black" Foreground="Turquoise" FontSize="14"/>

        <TextBlock Grid.Row="2" Text="Warning: This will permanently delete the album and cannot be undone."
                   Foreground="IndianRed" TextWrapping="Wrap" Margin="0,8,0,20"
                   HorizontalAlignment="Center" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Delete Album" Width="160" Margin="0,0,24,0" Click="btnDelete_Click"
                    Background="Black" Foreground="IndianRed" Padding="10"/>
            <Button Content="Cancel" Width="110" Click="btnCancel_Click"
                    Background="Black" Foreground="Turquoise" Padding="10"/>
        </StackPanel>
    </Grid>
</Window>