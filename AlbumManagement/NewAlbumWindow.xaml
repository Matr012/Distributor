<Window x:Class="MMZClient.AlbumManagement.NewAlbumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MMZClient.AlbumManagement"
        mc:Ignorable="d"
        Title="NewAlbumWindow" Height="450" Width="800" Background="Black">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Title:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxTitle" Grid.Row="0" Margin="80,0,0,8" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="1" Content="Subtitle:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxSubtitle" Grid.Row="1" Margin="80,0,0,8" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="2" Content="EAN/UPC:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxEanUpc" Grid.Row="2" Margin="80,0,0,8" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="3" Content="Code Request:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxCodeRequest" Grid.Row="3" Margin="80,0,0,8" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="4" Content="Original Release Date:" Foreground="Turquoise"/>
        <DatePicker x:Name="dpOriginalRelease" Grid.Row="4" Margin="140,0,0,8"/>

        <Label Grid.Row="5" Content="Digital Release Date:" Foreground="Turquoise"/>
        <DatePicker x:Name="dpDigitalRelease" Grid.Row="5" Margin="140,0,0,8"/>

        <Label Grid.Row="6" Content="Music Style:" Foreground="Turquoise"/>
        <ComboBox x:Name="cbxStyle" Grid.Row="6" Margin="80,0,0,8" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="7" Content="Cover Path / Filename:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxCoverPath" Grid.Row="7" Margin="140,0,0,8" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="8" Content="Spotify Artist URL:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxSpotifyUrl" Grid.Row="8" Margin="140,0,0,8" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="9" Content="Apple Artist URL:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxAppleUrl" Grid.Row="9" Margin="140,0,0,8" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="10" Content="Redistribution:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxRedistribution" Grid.Row="10" Margin="140,0,0,8" Background="Black" Foreground="Turquoise"/>

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" >
            <Button Content="Save" Width="90" Margin="0,0,10,0" Click="btnSave_Click" IsDefault="True" Background="Black" Foreground="Turquoise"/>
            <Button Content="Exit" Width="90" Click="btnExit_Click" IsCancel="True" Background="Black" Foreground="Turquoise"/>
        </StackPanel>
    </Grid>
</Window>
