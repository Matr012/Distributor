<Window x:Class="MMZClient.AlbumManagement.UpdateAlbumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update Album" Height="520" Width="820" Background="Black"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Album ID:" Foreground="Turquoise" FontWeight="SemiBold"/>
        <TextBox x:Name="tbxAlbumId" Grid.Row="0" Margin="100,0,0,10" Background="Black" Foreground="Turquoise" IsReadOnly="True"/>

        <Label Grid.Row="1" Content="Title:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxTitle" Grid.Row="1" Margin="100,0,0,10" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="2" Content="Subtitle:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxSubtitle" Grid.Row="2" Margin="100,0,0,10" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="3" Content="EAN/UPC:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxEanUpc" Grid.Row="3" Margin="100,0,0,10" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="4" Content="Code Request:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxCodeRequest" Grid.Row="4" Margin="100,0,0,10" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="5" Content="Original Release Date:" Foreground="Turquoise"/>
        <DatePicker x:Name="dpOriginalRelease" Grid.Row="5" Margin="160,0,0,10"/>

        <Label Grid.Row="6" Content="Digital Release Date:" Foreground="Turquoise"/>
        <DatePicker x:Name="dpDigitalRelease" Grid.Row="6" Margin="160,0,0,10"/>

        <Label Grid.Row="7" Content="Music Style:" Foreground="Turquoise"/>
        <ComboBox x:Name="cbxStyle" Grid.Row="7" Margin="100,0,0,10" Background="Black" Foreground="Turquoise" IsEditable="True"/>

        <Label Grid.Row="8" Content="Cover Path / Filename:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxCoverPath" Grid.Row="8" Margin="160,0,0,10" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="9" Content="Spotify Artist URL:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxSpotifyUrl" Grid.Row="9" Margin="160,0,0,10" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="10" Content="Apple Artist URL:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxAppleUrl" Grid.Row="10" Margin="160,0,0,10" Background="Black" Foreground="Turquoise"/>

        <Label Grid.Row="11" Content="Redistribution:" Foreground="Turquoise"/>
        <TextBox x:Name="tbxRedistribution" Grid.Row="11" Margin="160,0,0,10" Background="Black" Foreground="Turquoise"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Save Changes" Width="140" Margin="0,0,12,0" Click="btnSave_Click" 
                    IsDefault="True" Background="Black" Foreground="Turquoise" Padding="8"/>
            <Button Content="Cancel" Width="100" Click="btnCancel_Click" IsCancel="True"
                    Background="Black" Foreground="Turquoise" Padding="8"/>
        </StackPanel>
    </Grid>
</Window>