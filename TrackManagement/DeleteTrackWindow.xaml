<Window x:Class="MMZClient.TrackManagement.DeleteTrackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Track" Height="220" Width="480"
        Background="Black" Foreground="Turquoise"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Are you sure you want to delete this track?" 
                   FontSize="16" TextWrapping="Wrap" Foreground="Turquoise" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Yes, Delete" Width="120" Margin="0,0,12,0"
                    Click="btnDelete_Click" Foreground="White" Background="DarkRed" Padding="10,6"/>
            <Button Content="Cancel" Width="100"
                    Click="btnCancel_Click" Foreground="Turquoise" Background="Black" Padding="10,6"/>
        </StackPanel>
    </Grid>
</Window>