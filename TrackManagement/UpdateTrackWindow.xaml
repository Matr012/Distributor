<Window x:Class="MMZClient.TrackManagement.UpdateTrackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Track" Height="640" Width="620"
        Background="Black" Foreground="Turquoise"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Track ID:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtTrackId" Grid.Row="0" Margin="120,8,0,4" Height="26" IsReadOnly="True" Background="#FF111111" Foreground="LightGray"/>

        <Label Grid.Row="1" Content="Album ID:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtAlbumId" Grid.Row="1" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="2" Content="Track Number:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtTrackNumber" Grid.Row="2" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="3" Content="Title:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtTitle" Grid.Row="3" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="4" Content="Subtitle:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtSubtitle" Grid.Row="4" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="5" Content="ISRC Request:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtIsrcRequest" Grid.Row="5" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="6" Content="Original Release Date:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <DatePicker x:Name="dpOriginalRelease" Grid.Row="6" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="7" Content="Explicit Lyrics:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <ComboBox x:Name="cbxExplicit" Grid.Row="7" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="8" Content="Collaborators:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtCollaborators" Grid.Row="8" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="9" Content="Composers:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtComposers" Grid.Row="9" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="10" Content="Lyricists:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtLyricists" Grid.Row="10" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="11" Content="Audio Path / Filename:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtAudioPath" Grid.Row="11" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="12" Content="Music Style:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <ComboBox x:Name="cbxStyle" Grid.Row="12" Margin="120,8,0,4" Height="26" IsEditable="True"/>

        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Update" Width="100" Margin="0,0,10,0"
                    Click="btnUpdate_Click" Foreground="Turquoise" Background="Black" Padding="10,5"/>
            <Button Content="Cancel" Width="100"
                    Click="btnCancel_Click" Foreground="Turquoise" Background="Black" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>