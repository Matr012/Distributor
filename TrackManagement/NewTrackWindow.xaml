<Window x:Class="MMZClient.TrackManagement.NewTrackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NewTrack" Height="620" Width="620" 
        Background="Black" Foreground="Turquoise">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Album ID:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtAlbumId" Grid.Row="0" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="1" Content="Track Number:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtTrackNumber" Grid.Row="1" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="2" Content="Title:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtTitle" Grid.Row="2" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="3" Content="Subtitle:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtSubtitle" Grid.Row="3" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="4" Content="ISRC Request:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtIsrcRequest" Grid.Row="4" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="5" Content="Original Release Date:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <DatePicker x:Name="dpOriginalRelease" Grid.Row="5" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="6" Content="Explicit Lyrics:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <ComboBox x:Name="cbxExplicit" Grid.Row="6" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="7" Content="Collaborators:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtCollaborators" Grid.Row="7" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="8" Content="Composers:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtComposers" Grid.Row="8" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="9" Content="Lyricists:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtLyricists" Grid.Row="9" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="10" Content="Audio Path / Filename:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="txtAudioPath" Grid.Row="10" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="11" Content="Music Style:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <ComboBox x:Name="cbxStyle" Grid.Row="11" Margin="120,8,0,4" Height="26" IsEditable="True"/>
        <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Width="100" Margin="0,0,10,0" 
                    Click="btnSave_Click" Foreground="Turquoise" Background="Black" 
                    Padding="10,5"/>
            <Button Content="Exit" Width="100" 
                    Click="btnExit_Click" Foreground="Turquoise" Background="Black" 
                    Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>