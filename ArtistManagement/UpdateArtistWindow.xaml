<Window x:Class="MMZClient.ArtistManagement.UpdateArtistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Artist" Height="560" Width="620"
        Background="Black" Foreground="Turquoise"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Artist ID:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="tbxId" Grid.Row="0" Margin="120,8,0,4" Height="26" IsReadOnly="True" Background="#FF111111" Foreground="LightGray"/>

        <Label Grid.Row="1" Content="Name:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="tbxName" Grid.Row="1" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="2" Content="Description:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="tbxDescription" Grid.Row="2" Margin="120,8,0,4" Height="80"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <Label Grid.Row="3" Content="Spotify URL:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="tbxSpotifyUrl" Grid.Row="3" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="4" Content="Soundcloud URL:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="tbxSoundcloudUrl" Grid.Row="4" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="5" Content="Other Socials:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="tbxOtherSocials" Grid.Row="5" Margin="120,8,0,4" Height="26"/>

        <Label Grid.Row="6" Content="Avatar / Image Path:" Foreground="Turquoise" Margin="0,8,0,4"/>
        <TextBox x:Name="tbxAvatar" Grid.Row="6" Margin="120,8,0,4" Height="26"/>

        <Grid Grid.Row="7" Height="10"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Update" Width="100" Margin="0,0,10,0"
                    Click="btnUpdate_Click" Foreground="Turquoise" Background="Black"
                    Padding="10,5"/>
            <Button Content="Cancel" Width="100"
                    Click="btnCancel_Click" Foreground="Turquoise" Background="Black"
                    Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>