<Window x:Class="MMZClient.ArtistManagement.DeleteArtistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Artist" Height="220" Width="480"
        Background="Black" Foreground="Turquoise"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Are you sure you want to delete this artist?" 
                   FontSize="14" Foreground="Turquoise" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="ID:" Foreground="LightGray" Margin="0,4,12,4"/>
            <TextBlock x:Name="tbkId" Foreground="White" FontWeight="SemiBold" Margin="0,4"/>
            <TextBlock Text="   Name:" Foreground="LightGray" Margin="20,4,12,4"/>
            <TextBlock x:Name="tbkName" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="This action cannot be undone." 
                   Foreground="IndianRed" FontStyle="Italic" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Delete" Width="100" Margin="0,0,10,0"
                    Click="btnDelete_Click" Foreground="White" Background="DarkRed"
                    Padding="10,5"/>
            <Button Content="Cancel" Width="100"
                    Click="btnCancel_Click" Foreground="Turquoise" Background="Black"
                    Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>